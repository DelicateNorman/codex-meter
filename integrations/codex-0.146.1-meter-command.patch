+    fn add_meter_output(&mut self) {
+        let program = std::env::var_os("CODEX_METER_BIN")
+            .unwrap_or_else(|| std::ffi::OsString::from("codex-meter"));
+        match std::process::Command::new(program)
+            .args(["--no-color", "today", "--refresh"])
+            .output()
+        {
+            Ok(output) if output.status.success() => {
+                let text = String::from_utf8_lossy(&output.stdout);
+                let lines = text
+                    .lines()
+                    .map(|line| Line::from(line.to_owned()))
+                    .collect();
+                self.add_plain_history_lines(lines);
+            }
+            Ok(output) => {
+                let detail = String::from_utf8_lossy(&output.stderr);
+                self.add_error_message(format!("Codex Meter failed: {}", detail.trim()));
+            }
+            Err(err) => self.add_error_message(format!(
+                "Could not run codex-meter: {err}. Install Codex Meter or set CODEX_METER_BIN."
+            )),
+        }
+    }
